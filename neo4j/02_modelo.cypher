MERGE (n:Regla {id: 'MAN-R8'}) SET n.nombre = 'Escalado al cliente', n.submodulo = 'MAN', n.condicion = 'existe Conflicto y todas sus alternativas son no viables', n.conclusion = 'Conflicto Inviable → Aclaración (motivo rigidez) vía Interpretación', n.origen = 'propuesta', n.tipo = 'Inferencial', n.fuente = 'PI2 Luciano R8', n.estado_validacion = 'Formalizada PI2', n.implementacion = '04 (sin caso que la dispare)';
MATCH (n:Regla {id: 'MAN-R8'}), (s:Slot {id: 'Conflicto.estado'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'MAN-R8'}), (s:Slot {id: 'AlternativaRediseno.viable'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'MAN-R9'}) SET n.nombre = 'Instalación no invasiva', n.submodulo = 'MAN', n.condicion = 'RiesgoCaída e instalacion_no_invasiva', n.conclusion = 'RECHAZA CambioFijación, ADMITE ReducirInfill', n.origen = 'experto', n.tipo = 'Contextual', n.fuente = 'PI2 Luciano R9 / PI1 Luciano caso 2', n.estado_validacion = 'Formalizada PI2', n.implementacion = '04';
MATCH (n:Regla {id: 'MAN-R9'}), (s:Slot {id: 'RestriccionCliente.criterio'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'MAN-R9'}), (s:Slot {id: 'SistemaFijacion.requiere_perforar'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'MAN-FILTRO'}) SET n.nombre = 'Filtro por restricciones innegociables', n.submodulo = 'MAN', n.condicion = 'ninguna RestriccionCliente obligatoria rechaza la alternativa', n.conclusion = 'alternativa viable (ADMITE si la restricción la respeta explícitamente)', n.origen = 'experto', n.tipo = 'Determinística', n.fuente = 'PI1 Luciano etapa 5 / PI2 RL8', n.estado_validacion = 'Formalizada PI2', n.implementacion = '04';
MATCH (n:Regla {id: 'MAN-FILTRO'}), (s:Slot {id: 'RestriccionCliente.rigidez'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'MAN-FILTRO'}), (s:Slot {id: 'AlternativaRediseno.viable'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'MAN-G1'}) SET n.nombre = 'Exterior → placa base más gruesa (regla general)', n.submodulo = 'MAN', n.condicion = 'cartel exterior', n.conclusion = 'usar placa base de mayor grosor [PENDIENTE: espesor]', n.origen = 'experto', n.tipo = 'Contextual', n.fuente = 'PI1 Luciano §6 (regla general)', n.estado_validacion = 'Relevada en PI1; sin valor', n.implementacion = 'no (sin espesor relevado)';
MATCH (n:Regla {id: 'MAN-G1'}), (s:Slot {id: 'Entorno.tipo'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INTEG-01'}) SET n.nombre = 'Ficha → Cartel', n.submodulo = 'COM', n.condicion = 'existe FichaRequerimientos sin Cartel asociado', n.conclusion = 'instanciar Cartel/Entorno con los DatosConfirmados de la ficha (sin completar huecos)', n.origen = 'propuesta', n.tipo = 'Determinística', n.fuente = 'Interacción PI1 (los tres) + RL12 Luciano', n.estado_validacion = 'Propuesta de integración', n.implementacion = '04';
MATCH (n:Regla {id: 'INTEG-01'}), (s:Slot {id: 'FichaRequerimientos.id'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INTEG-01'}), (s:Slot {id: 'Cartel.dimension_maxima_mm'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INTEG-02'}) SET n.nombre = 'Recomendación y traza', n.submodulo = 'COM', n.condicion = 'Conflictos de manufactura resueltos con alternativas viables', n.conclusion = 'Recomendación que CONFORMAN las alternativas + registrar Evaluacion (reglas activadas)', n.origen = 'propuesta', n.tipo = 'Inferencial', n.fuente = 'PI1 Luciano etapa 6 + pregunta integrador «Trazabilidad»', n.estado_validacion = 'Propuesta de integración', n.implementacion = '04';
MATCH (n:Regla {id: 'INTEG-02'}), (s:Slot {id: 'Recomendacion.tipo'}) MERGE (n)-[:USA]->(s);

// ---------- 6. Excepciones ----------
MERGE (e:Excepcion {id: 'EX-01'}) SET e.condicion = 'Cartel exterior dentro de un nicho o bajo un alero efectivo', e.efecto = 'Se reduce la exposición / el grado IP exigido (magnitud a validar)', e.fuente = 'PI1 Lautaro §6';
MATCH (e:Excepcion {id: 'EX-01'}), (r:Regla {id: 'R-MI-02'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-02'}) SET e.condicion = 'Interior húmedo (cocina, natatorio, junto al mar) o con sol directo', e.efecto = 'Se evalúa con criterios de exterior', e.fuente = 'PI1 Lautaro §6';
MATCH (e:Excepcion {id: 'EX-02'}), (r:Regla {id: 'R-MI-GEN'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-03'}) SET e.condicion = 'Existe estructura portante accesible detrás del revestimiento', e.efecto = 'Pasa de no apto a apto con condiciones', e.fuente = 'PI1 Lautaro §6';
MATCH (e:Excepcion {id: 'EX-03'}), (r:Regla {id: 'R-MI-05'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-04'}) SET e.condicion = 'Gran porte, bandera o altura con viento', e.efecto = 'El sistema no resuelve la fijación: deriva a un profesional', e.fuente = 'PI1 Lautaro §6';
MATCH (e:Excepcion {id: 'EX-04'}), (r:Regla {id: 'R-MI-06'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-05'}) SET e.condicion = 'Cartel exterior dentro de un nicho', e.efecto = 'Se puede relajar el grosor de la placa base', e.fuente = 'PI1 Luciano §6';
MATCH (e:Excepcion {id: 'EX-05'}), (r:Regla {id: 'MAN-G1'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-06'}) SET e.condicion = 'Información ausente que puede completarse más adelante', e.efecto = 'El faltante es postergable y no bloquea (viaja como advertencia)', e.fuente = 'PI1 Matías §6';
MATCH (e:Excepcion {id: 'EX-06'}), (r:Regla {id: 'INT-R11'}) MERGE (e)-[:MODIFICA]->(r);
