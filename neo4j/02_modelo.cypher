MATCH (a:Frame {nombre: 'AlternativaRediseno'}), (b:Frame {nombre: 'AlternativaRediseno'}) MERGE (a)-[r:EXIGE]->(b) SET r.fuente = 'MAN RL6', r.nivel = 'esquema';
