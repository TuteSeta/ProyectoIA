MATCH (e:Excepcion {id: 'EX-04'}), (r:Regla {id: 'R-MI-06'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-05'}) SET e.condicion = 'Cartel exterior dentro de un nicho', e.efecto = 'Se puede relajar el grosor de la placa base', e.fuente = 'PI1 Luciano §6';
MATCH (e:Excepcion {id: 'EX-05'}), (r:Regla {id: 'MAN-G1'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-06'}) SET e.condicion = 'Información ausente que puede completarse más adelante', e.efecto = 'El faltante es postergable y no bloquea (viaja como advertencia)', e.fuente = 'PI1 Matías §6';
MATCH (e:Excepcion {id: 'EX-06'}), (r:Regla {id: 'INT-R11'}) MERGE (e)-[:MODIFICA]->(r);
MERGE (e:Excepcion {id: 'EX-07'}) SET e.condicion = 'Falta material, componente o ubicación de la fuente (lo elige el rediseño)', e.efecto = 'No bloquea: pasa como requisito (R-MI-13)', e.fuente = 'PI2 Lautaro M3 / M8';
MATCH (e:Excepcion {id: 'EX-07'}), (r:Regla {id: 'R-MI-01'}) MERGE (e)-[:MODIFICA]->(r);
