// ---------- 4. Relaciones de la red semántica integrada ----------
MATCH (a:Frame {nombre: 'Cliente'}), (b:Frame {nombre: 'Pedido'}) MERGE (a)-[r:FORMULA]->(b) SET r.fuente = 'INT RL01', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Pedido'}), (b:Frame {nombre: 'ExpresionCliente'}) MERGE (a)-[r:CONTIENE]->(b) SET r.fuente = 'INT RL02', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Pedido'}), (b:Frame {nombre: 'ReferenciaVisual'}) MERGE (a)-[r:INCLUYE]->(b) SET r.fuente = 'INT RL03', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'ExpresionCliente'}), (b:Frame {nombre: 'Requerimiento'}) MERGE (a)-[r:SE_INTERPRETA_COMO]->(b) SET r.fuente = 'INT RL05', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'ExpresionCliente'}), (b:Frame {nombre: 'Dato'}) MERGE (a)-[r:APORTA]->(b) SET r.fuente = 'INT RL06', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'ReferenciaVisual'}), (b:Frame {nombre: 'Dato'}) MERGE (a)-[r:APORTA]->(b) SET r.fuente = 'INT RL07', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Requerimiento'}), (b:Frame {nombre: 'Dato'}) MERGE (a)-[r:SE_DESCRIBE_MEDIANTE]->(b) SET r.fuente = 'INT RL08', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Dato'}), (b:Frame {nombre: 'CategoriaDato'}) MERGE (a)-[r:PERTENECE_A]->(b) SET r.fuente = 'INT RL09', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Contradiccion'}), (b:Frame {nombre: 'DatoEnConflicto'}) MERGE (a)-[r:INVOLUCRA]->(b) SET r.fuente = 'INT RL10', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'DatoFaltante'}), (b:Frame {nombre: 'Aclaracion'}) MERGE (a)-[r:PROVOCA]->(b) SET r.fuente = 'INT RL11', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'DatoAmbiguo'}), (b:Frame {nombre: 'Aclaracion'}) MERGE (a)-[r:PROVOCA]->(b) SET r.fuente = 'INT RL11', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Contradiccion'}), (b:Frame {nombre: 'Aclaracion'}) MERGE (a)-[r:PROVOCA]->(b) SET r.fuente = 'INT RL11', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'SM_Interpretacion'}), (b:Frame {nombre: 'Aclaracion'}) MERGE (a)-[r:SOLICITA]->(b) SET r.fuente = 'INT RL12', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Aclaracion'}), (b:Frame {nombre: 'Cliente'}) MERGE (a)-[r:SE_DIRIGE_A]->(b) SET r.fuente = 'INT RL13', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Aclaracion'}), (b:Frame {nombre: 'Pedido'}) MERGE (a)-[r:ACTUALIZA]->(b) SET r.fuente = 'INT RL14', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'SM_Interpretacion'}), (b:Frame {nombre: 'Pedido'}) MERGE (a)-[r:EVALUA_SUFICIENCIA_DE]->(b) SET r.fuente = 'INT RL15', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'DatoFaltante'}), (b:Frame {nombre: 'SM_Materiales'}) MERGE (a)-[r:REQUIERE_CONSULTA_A]->(b) SET r.fuente = 'INT RL16 (vía ConsultaSubmodulo)', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'SM_Interpretacion'}), (b:Frame {nombre: 'FichaRequerimientos'}) MERGE (a)-[r:PRODUCE]->(b) SET r.fuente = 'INT RL17', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'FichaRequerimientos'}), (b:Frame {nombre: 'DatoConfirmado'}) MERGE (a)-[r:REGISTRA]->(b) SET r.fuente = 'INT RL18', r.nivel = 'esquema';
