MATCH (a:Frame {nombre: 'Cartel'}), (b:Frame {nombre: 'Geometria'}) MERGE (a)-[r:TIENE]->(b) SET r.fuente = 'MAN RL1', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Cartel'}), (b:Frame {nombre: 'TecnologiaIluminacion'}) MERGE (a)-[r:REQUIERE]->(b) SET r.fuente = 'MAN RL3', r.nivel = 'esquema';
MATCH (a:Frame {nombre: 'Herramienta'}), (b:Frame {nombre: 'RestriccionConstructiva'}) MERGE (a)-[r:DEFINE]->(b) SET r.fuente = 'MAN RL11', r.nivel = 'esquema';
