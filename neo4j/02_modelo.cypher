// ---------- 5. Reglas trazables ----------
MERGE (n:Regla {id: 'INT-R01'}) SET n.nombre = 'Ambigüedad interpretativa', n.submodulo = 'INT', n.condicion = 'Expresión con más de una interpretación razonable y sin confirmar', n.conclusion = 'crear DatoAmbiguo (valor nulo) + Aclaración (motivo ambigüedad)', n.origen = 'propuesta', n.tipo = 'Heurística / subjetiva', n.fuente = 'PI1 Matías regla 1', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R01'}), (s:Slot {id: 'ExpresionCliente.interpretaciones_posibles'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R01'}), (s:Slot {id: 'DatoAmbiguo.interpretaciones'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R01'}), (s:Slot {id: 'Aclaracion.motivo'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R02'}) SET n.nombre = 'Dato requerido faltante', n.submodulo = 'INT', n.condicion = 'atributo de datos_requeridos sin Dato aportado ni NF que lo cubra', n.conclusion = 'crear DatoFaltante (sin_clasificar), Pedido OMITE, Aclaración', n.origen = 'propuesta', n.tipo = 'Determinística', n.fuente = 'PI1 Matías reglas 2 y 7', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R02'}), (s:Slot {id: 'Pedido.datos_requeridos'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R02'}), (s:Slot {id: 'DatoFaltante.criticidad'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R03'}) SET n.nombre = 'Contradicción entre datos', n.submodulo = 'INT', n.condicion = 'dos Datos del mismo atributo con valores incompatibles', n.conclusion = 'crear Contradicción abierta, datos en_conflicto, Aclaración', n.origen = 'propuesta', n.tipo = 'Determinística', n.fuente = 'PI1 Matías regla 3', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R03'}), (s:Slot {id: 'Contradiccion.estado'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R03'}), (s:Slot {id: 'ReferenciaVisual.consistente_con_texto'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R04'}) SET n.nombre = 'Restricción explícita', n.submodulo = 'INT', n.condicion = 'el cliente declara explícitamente que una condición debe cumplirse', n.conclusion = 'crear RestriccionCliente (obligatoria) en la ficha', n.origen = 'propuesta', n.tipo = 'Heurística / empírica', n.fuente = 'PI1 Matías regla 4', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R04'}), (s:Slot {id: 'RestriccionCliente.rigidez'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R05'}) SET n.nombre = 'Preferencia no promovible', n.submodulo = 'INT', n.condicion = 'condición expresada como deseo, sin marca de obligatoriedad', n.conclusion = 'crear Preferencia; no promover a restricción sin confirmación', n.origen = 'propuesta', n.tipo = 'Heurística / empírica', n.fuente = 'PI1 Matías regla 5', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R05'}), (s:Slot {id: 'Preferencia.rigidez'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R06'}) SET n.nombre = 'Rigidez a confirmar', n.submodulo = 'INT', n.condicion = 'no puede determinarse si es obligatoria o deseo', n.conclusion = 'rigidez = a_confirmar + Aclaración (motivo rigidez)', n.origen = 'propuesta', n.tipo = 'Subjetiva', n.fuente = 'PI1 Matías caso límite 5', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = 'no (sin caso)';
MATCH (n:Regla {id: 'INT-R06'}), (s:Slot {id: 'Requerimiento.rigidez'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R07'}) SET n.nombre = 'Necesidad funcional sin tecnología', n.submodulo = 'INT', n.condicion = 'el cliente describe un efecto y no define la tecnología (sin ambigüedad pendiente)', n.conclusion = 'crear NecesidadFuncional (tecnología no_definida) que CUBRE producto_tecnologia', n.origen = 'propuesta', n.tipo = 'Inferencial', n.fuente = 'PI1 Matías regla 6', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R07'}), (s:Slot {id: 'NecesidadFuncional.tecnologia_asociada'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R07'}), (s:Slot {id: 'NecesidadFuncional.cubre'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R08'}) SET n.nombre = 'Formulación adaptada', n.submodulo = 'INT', n.condicion = 'se crea una Aclaración', n.conclusion = 'formulación técnica si conoce_terminologia = si; si no, en términos de uso', n.origen = 'propuesta', n.tipo = 'Contextual', n.fuente = 'PI1 Matías excepción 2', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R08'}), (s:Slot {id: 'Cliente.conoce_terminologia'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R08'}), (s:Slot {id: 'Aclaracion.formulacion'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R09'}) SET n.nombre = 'Prohibición de inventar valores', n.submodulo = 'INT', n.condicion = 'se intenta asignar un valor con origen distinto de cliente / respuesta_a_aclaracion', n.conclusion = 'rechazar la asignación; el dato sigue faltante', n.origen = 'propuesta', n.tipo = 'Determinística (integridad)', n.fuente = 'PI1 Matías regla 9 + criterio de validez', n.estado_validacion = 'Validada como criterio de diseño', n.implementacion = '04 (control de integridad)';
MATCH (n:Regla {id: 'INT-R09'}), (s:Slot {id: 'Dato.origen'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R10'}) SET n.nombre = 'Consulta a otro submódulo', n.submodulo = 'INT', n.condicion = 'la necesidad o criticidad de un dato depende de materiales/instalación/manufactura', n.conclusion = 'crear ConsultaSubmodulo dirigida al submódulo dueño', n.origen = 'propuesta', n.tipo = 'Contextual', n.fuente = 'PI1 Matías regla 10', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '03 (precargada)';
MATCH (n:Regla {id: 'INT-R10'}), (s:Slot {id: 'DatoFaltante.criticidad'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R10'}), (s:Slot {id: 'ConsultaSubmodulo.pregunta'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R11'}) SET n.nombre = 'Suficiencia del pedido', n.submodulo = 'INT', n.condicion = 'todo dato requerido confirmado, cubierto por NF o faltante postergable; sin ambiguos; sin contradicciones abiertas', n.conclusion = 'Pedido.estado = listo_para_evaluacion + crear FichaRequerimientos', n.origen = 'propuesta', n.tipo = 'Determinística / inferencial', n.fuente = 'PI1 Matías regla 8', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '04';
MATCH (n:Regla {id: 'INT-R11'}), (s:Slot {id: 'Pedido.estado'}) MERGE (n)-[:USA]->(s);
