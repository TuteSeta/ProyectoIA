MATCH (a:Frame {nombre: 'Cartel'}), (b:Frame {nombre: 'Material'}) MERGE (a)-[r:UTILIZA]->(b) SET r.fuente = 'MAT RL4 usa = MAN RL2 utiliza', r.nivel = 'esquema';
