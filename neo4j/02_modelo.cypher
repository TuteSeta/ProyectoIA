// ---------- 2. Herencia (ES_UN) y composición (ES_PARTE_DE) ----------
MATCH (h:Frame {nombre: 'ExpresionCliente'}), (p:Frame {nombre: 'Pedido'}) MERGE (h)-[:ES_PARTE_DE]->(p);
MATCH (h:Frame {nombre: 'RestriccionCliente'}), (p:Frame {nombre: 'Requerimiento'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'Preferencia'}), (p:Frame {nombre: 'Requerimiento'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'NecesidadFuncional'}), (p:Frame {nombre: 'Requerimiento'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'DatoConfirmado'}), (p:Frame {nombre: 'Dato'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'DatoFaltante'}), (p:Frame {nombre: 'Dato'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'DatoAmbiguo'}), (p:Frame {nombre: 'Dato'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'DatoEnConflicto'}), (p:Frame {nombre: 'Dato'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'Advertencia'}), (p:Frame {nombre: 'FichaRequerimientos'}) MERGE (h)-[:ES_PARTE_DE]->(p);
MATCH (h:Frame {nombre: 'SM_Interpretacion'}), (p:Frame {nombre: 'Submodulo'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'SM_Materiales'}), (p:Frame {nombre: 'Submodulo'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'SM_Manufacturabilidad'}), (p:Frame {nombre: 'Submodulo'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'PLA'}), (p:Frame {nombre: 'Material'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'PETG'}), (p:Frame {nombre: 'Material'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'Acrilico'}), (p:Frame {nombre: 'Material'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'ComponenteElectrico'}), (p:Frame {nombre: 'Cartel'}) MERGE (h)-[:ES_PARTE_DE]->(p);
MATCH (h:Frame {nombre: 'Geometria'}), (p:Frame {nombre: 'Cartel'}) MERGE (h)-[:ES_PARTE_DE]->(p);
MATCH (h:Frame {nombre: 'NeonFrontal'}), (p:Frame {nombre: 'TecnologiaIluminacion'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'Retroiluminado'}), (p:Frame {nombre: 'TecnologiaIluminacion'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'RestriccionTrazo'}), (p:Frame {nombre: 'RestriccionConstructiva'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'RestriccionVolumen'}), (p:Frame {nombre: 'RestriccionConstructiva'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'RestriccionPeso'}), (p:Frame {nombre: 'RestriccionConstructiva'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'RestriccionTemperatura'}), (p:Frame {nombre: 'RestriccionConstructiva'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'CambioMaterial'}), (p:Frame {nombre: 'AlternativaRediseno'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'CambioGeometria'}), (p:Frame {nombre: 'AlternativaRediseno'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'CambioFijacion'}), (p:Frame {nombre: 'AlternativaRediseno'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'CambioTecnologia'}), (p:Frame {nombre: 'AlternativaRediseno'}) MERGE (h)-[:ES_UN]->(p);
MATCH (h:Frame {nombre: 'SegmentacionModular'}), (p:Frame {nombre: 'AlternativaRediseno'}) MERGE (h)-[:ES_UN]->(p);

// ---------- 3. Slots con facetas y demonios ----------
MERGE (s:Slot {id: 'Cliente.identificacion'}) SET s.nombre = 'identificacion', s.frame = 'Cliente', s.tipo_dato = 'Texto', s.valores_permitidos = '', s.valor_defecto = '', s.cardinalidad = '1', s.si_necesario = '', s.si_agregado = '', s.si_modificado = '', s.nota = '';
MATCH (f:Frame {nombre: 'Cliente'}), (s:Slot {id: 'Cliente.identificacion'}) MERGE (f)-[:TIENE_SLOT]->(s);
MERGE (s:Slot {id: 'Cliente.conoce_terminologia'}) SET s.nombre = 'conoce_terminologia', s.frame = 'Cliente', s.tipo_dato = 'Enum', s.valores_permitidos = 'si | no | desconocido', s.valor_defecto = 'desconocido', s.cardinalidad = '1', s.si_necesario = 'estimar por el vocabulario de sus expresiones', s.si_agregado = '', s.si_modificado = '', s.nota = '';
MATCH (f:Frame {nombre: 'Cliente'}), (s:Slot {id: 'Cliente.conoce_terminologia'}) MERGE (f)-[:TIENE_SLOT]->(s);
MERGE (s:Slot {id: 'Pedido.id'}) SET s.nombre = 'id', s.frame = 'Pedido', s.tipo_dato = 'Texto', s.valores_permitidos = 'único', s.valor_defecto = '', s.cardinalidad = '1', s.si_necesario = '', s.si_agregado = '', s.si_modificado = '', s.nota = '';
MATCH (f:Frame {nombre: 'Pedido'}), (s:Slot {id: 'Pedido.id'}) MERGE (f)-[:TIENE_SLOT]->(s);
MERGE (s:Slot {id: 'Pedido.estado'}) SET s.nombre = 'estado', s.frame = 'Pedido', s.tipo_dato = 'Enum', s.valores_permitidos = 'en_interpretacion | pendiente_de_aclaracion | listo_para_evaluacion', s.valor_defecto = 'en_interpretacion', s.cardinalidad = '1', s.si_necesario = 'listo solo si se cumple INT-R11; si no, pendiente si hay aclaraciones/consultas abiertas', s.si_agregado = '', s.si_modificado = '', s.nota = 'Solo INT-R11 asigna listo_para_evaluacion (M17)';
