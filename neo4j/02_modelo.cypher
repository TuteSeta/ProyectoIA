// 02_modelo.cypher — Red semántica integrada + jerarquía de frames (slots y facetas) + reglas + excepciones
// Generado por salida/build/gen_cypher.py desde salida/build/modelo_spec.py (no editar a mano).
// Patrón: (:Frame {tipo:'clase'}) -[:ES_UN]-> padre ; -[:ES_PARTE_DE]-> todo ; -[:TIENE_SLOT]-> (:Slot)
//         facetas como propiedades del Slot; relaciones de la red semántica entre frames con el mismo
//         verbo que usan las instancias; (:Regla)-[:USA]->(:Slot) ; (:Excepcion)-[:MODIFICA]->(:Regla)

// ---------- 1. Frames (conceptos de la red) ----------
MERGE (n:Frame {nombre: 'Cliente'}) SET n.tipo = 'clase', n.submodulo = 'COM', n.descripcion = 'Quien formula el pedido, impone restricciones y responde aclaraciones.', n.origen = 'PI2 Matías N01 / PI2 Luciano C2', n.sinonimos = 'Solicitante, comitente', n.abstracto = false, n.pendiente = '';
MERGE (n:Frame {nombre: 'Pedido'}) SET n.tipo = 'clase', n.submodulo = 'INT', n.descripcion = 'Unidad de trabajo que se interpreta.', n.origen = 'PI2 Matías N02', n.sinonimos = 'Solicitud, encargo', n.abstracto = false, n.pendiente = '';
