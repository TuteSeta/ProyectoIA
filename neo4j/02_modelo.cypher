MATCH (n:Regla {id: 'INT-R11'}), (s:Slot {id: 'Contradiccion.estado'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R12'}) SET n.nombre = 'Herencia de incertidumbre', n.submodulo = 'INT', n.condicion = 'al crear la ficha hay faltantes postergables, rigidez a_confirmar o referencias restringidas', n.conclusion = 'crear una Advertencia por cada uno', n.origen = 'propuesta', n.tipo = 'Inferencial', n.fuente = 'PI1 Matías pregunta experta 8', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '04';
MATCH (n:Regla {id: 'INT-R12'}), (s:Slot {id: 'Advertencia.motivo'}) MERGE (n)-[:USA]->(s);
MATCH (n:Regla {id: 'INT-R12'}), (s:Slot {id: 'ReferenciaVisual.aporta_sobre'}) MERGE (n)-[:USA]->(s);
MERGE (n:Regla {id: 'INT-R13'}) SET n.nombre = 'Reingreso de la respuesta', n.submodulo = 'INT', n.condicion = 'una Aclaración pasa a respondida', n.conclusion = 'nueva Expresión (respuesta_a_aclaracion), reevaluar R01–R03/R07, iteración + 1', n.origen = 'propuesta', n.tipo = 'Determinística', n.fuente = 'PI1 Matías flecha «Nueva info»', n.estado_validacion = 'Candidata (pendiente de validación con el experto)', n.implementacion = '04';
