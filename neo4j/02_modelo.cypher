MERGE (e:Excepcion {id: 'EX-03'}) SET e.condicion = 'Existe estructura portante accesible detrás del revestimiento', e.efecto = 'La restricción de soporte pasa de excluyente a corregible', e.fuente = 'PI2 Lautaro R-MI-05 / §6';
MATCH (e:Excepcion {id: 'EX-03'}), (r:Regla {id: 'R-MI-05'}) MERGE (e)-[:MODIFICA]->(r);
